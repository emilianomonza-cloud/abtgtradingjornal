# ═══════════════════════════════════════════════════════════════
# MACRO SCENARIO ENGINE — configurazione ambiente
# Copiare in `.env` e modificare i valori. Nessuna chiave e' obbligatoria:
# senza chiavi il sistema funziona in modalita' rule-based completa.
# ═══════════════════════════════════════════════════════════════

# --- Applicazione ---
MSE_APP_NAME="Macro Scenario Engine"
MSE_HOST=127.0.0.1
MSE_PORT=8000
MSE_TIMEZONE=Europe/Rome
MSE_LOG_LEVEL=INFO

# --- Storage ---
# Percorso del database SQLite (relativo alla root del progetto se non assoluto)
MSE_DB_PATH=data/macro_scenario.db
MSE_CACHE_DIR=data/cache

# --- Collector HTTP ---
# User-agent dichiarato: obbligatorio per rispetto dei ToS delle fonti.
MSE_USER_AGENT="MacroScenarioEngine/1.0 (uso personale, non commerciale; contatto: cambia@questa.email)"
# Intervallo minimo fra due richieste alla STESSA fonte (secondi). Default 300 = 1 req / 5 min.
MSE_MIN_REQUEST_INTERVAL_SECONDS=300
MSE_HTTP_TIMEOUT_SECONDS=25
MSE_HTTP_MAX_RETRIES=3
# Se false i collector di rete sono disattivati (utile per test offline / CI).
MSE_NETWORK_ENABLED=true

# --- Scheduler ---
MSE_SCHEDULER_ENABLED=true
# Refresh calendario (minuti)
MSE_CALENDAR_REFRESH_MINUTES=60
# Refresh documenti banche centrali (minuti)
MSE_CB_REFRESH_MINUTES=180
# Rigenerazione scenari (minuti)
MSE_SCENARIO_REFRESH_MINUTES=15
# Export file snapshot per MT5 (minuti)
MSE_MT5_EXPORT_MINUTES=1

# --- Export MT5 ---
# Cartella MQL5\Files del terminale. Se vuota viene usata data/mt5/
# Windows esempio: C:\Users\NOME\AppData\Roaming\MetaQuotes\Terminal\<ID>\MQL5\Files
MSE_MT5_FILES_DIR=

# --- Layer semantico LLM (OPZIONALE) ---
# Se non valorizzato viene usato il classificatore rule-based (sempre funzionante).
# Provider supportato: anthropic | none  (richiede: pip install anthropic)
MSE_LLM_PROVIDER=none
MSE_LLM_API_KEY=
MSE_LLM_MODEL=claude-opus-5
MSE_LLM_BASE_URL=
MSE_LLM_TIMEOUT_SECONDS=45
